#include <bits/stdc++.h>

using namespace std;
void solve(){
    int n;
    cin >> n;
    //int a[26];
    char s[n];
    for(int i =0;i<n;i++) s[i] ='a';

    for(int i=1;i*i<=n;i++){
        if(n%i) continue;
        int k = i;
        for(int t=0;t<n/i;t++){
            int c = 1, x = 1;
            for(int j=t;j<n-k;j+=k){
                if(s[j+k] == s[j]){
                    //cout << s[j+k] <<'\n';
                    s[j+k] = (j-k >= 0)?s[j-k]:s[j]+1;
                    if(j+k-1 >=0 && s[j+k-1] == s[j+k]){
                        s[j+k] = s[j+k-1]+1;
                    } 
                    if(j+k+1 < n && s[j+k+1] == s[j+k]){
                        s[j+k] = s[j+k+1]+1;
                       /* if(s[j+k-1] == s[j+k]){
                            s[j+k] = s[j+k-1] + 2;
                        }*/
                    }
                    //cout << s[j+k] << '\n';
                }
               
            }
            if(t+1 < n && s[t+1] == s[t]) s[t+1] = (t-1>=0)?s[t-1]:(s[t] + 1)%('z'+1);
            //cout << s[t] << '\n';
            for(int i =0;i<n;i++) cout << s[i];
            cout << endl;
        }
    }
    for(int i =0;i<n;i++){
        cout << s[i];
    }
    cout << '\n';

}


int main(){
    int tc;

    cin >> tc;

    while(tc--) solve();
}
