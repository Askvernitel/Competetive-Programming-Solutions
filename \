#include <bits/stdc++.h>

using namespace std;

int n,m;
map<int, int> s;

void add(int k){
    if(k <=m) s[k]++;
    if(k != 1) s[1]++;
    for(int i =2;i*i<=k;i++){
        if(!(k%i)){
            if(i <= m) s[i]++;
            if(k/i <= m && i != k/i) s[k/i]++;
        }
    }

    
}
bool good(){
    cout << s.size() << '\n';
    return s.size() == m;
}
void remove(int k){
    if(k <= m){
        s[k]--; 
        if(s[k] ==0) s.erase(k);
    }
    if(k != 1){ 
        s[1]--;
        if(s[1] == 0) s.erase(1);
    }


    for(int i = 2;i*i<=k;i++){
        if(!(k%i)){
            if(i <= m){
                s[i]--;
                if(s[i] == 0) s.erase(i);
            }
            if(k/i <= m && k/i != i){
                s[k/i]--;
                if(s[k/i] == 0) s.erase(k/i);
            }
        }
    }
}
void solve(){
    cin >> n >> m;
    int a[n];
    for(int i =0;i<n;i++){
        cin >> a[i];
    }
    sort(a, a+n);
    int l =0, ans=-1;
    for(int r=0;r<n;r++){
        add(a[r]);
        good();
        while(good()){
            ans = min(ans, a[r]-a[l]);
            remove(a[l++]);
        }
    }
    cout << ans << '\n';
}
int main(){
    int tc;
    cin >> tc;
    while(tc--) solve();
}
