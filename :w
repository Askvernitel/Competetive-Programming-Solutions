#include <bits/stdc++.h>

using namespace std;
void solve(){
    int n;
    cin >> n;
    int a[n];
    for(int i =0;i<n;i++){
        cin >> a[i];
    }
    int end = n-1;
    for(int i =n-1;i>=0;i--){
        end = i;
        if(i+1 != a[i]){ 
            break;
        }
    }
    int ans = 0;
    int start = 0;
    for(int i =0;i<n;i++){
        start++;
        if(i+1 != a[i]){
            break;
        }
    }
    for(int i = start;i<end;i--){
        if(i + 1 == a[i]) ans++;
    }

    if(ans != 0) ans++;

    cout << ans << '\n';
}
int main(){
    int tc;
    cin >> tc;

    while(tc--) solve();
}
