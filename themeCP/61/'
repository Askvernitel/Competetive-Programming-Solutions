#include <bits/stdc++.h>

using namespace std;

int a[100001], h[100001];
int n, k;
bool good(int x){
	return x <= k ;
}
void solve(){
	cin >> n >> k;
	

	for(int i=0;i<n;i++){
		cin >> a[i];
	}
	for(int i=0;i<n;i++){
		cin >> h[i];
	}

	int pref[n+1];
	pref[0]=0;
	for(int i =1;i<=n;i++){
		pref[i] = pref[i-1] + a[i-1];
	}
	int l = 0;
	int prev = 1;
	int ans = 0;
	int cur = 0;
	for(int r= 0;r<n;r++){
		cur += a[r];
		if(h[r]%prev){ 
			l=r;
			prev = 1;
			cur = 0;
		}else prev = h[r];
		while(!good(cur)){ 
			cur-=a[l++];
		}
		ans = max(r-l+1, ans);
	}
	cout << ans << '\n';
}
int main(){
	int tc;
	cin >> tc;

	while(tc--) solve();
}
